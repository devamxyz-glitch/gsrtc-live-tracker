# ST Tracker — copy to .env and fill in. .env is gitignored and must stay that way.
#
# These are the upstream credentials. They are NOT in this repository on purpose: once a
# secret is committed it stays in git history for everyone who ever clones or forks it.
# What each value is, and where it came from, is written up in docs/API_RESEARCH.md.
#
# Quote any value containing '#' — unquoted, it starts a comment and the value is silently
# truncated, which surfaces as a confusing HTTP 401 from the upstream rather than an error here.

GSRTC_HOST="https://gujaratrajyamargvahanvyavaharcorporationmobileapi.infinium.management"
GSRTC_API_USER="AaMNex1201"
GSRTC_API_PASS="AaMNexg@3248!!#"
GSRTC_AES_KEY="1tyu89rtuqeoptyklltyussq"
GSRTC_AUTH_SECRET="&amnexiinfi9849&Infi#65899"
# Optional
# GSRTC_DEVICE_ID=0123456789abcdef
# GSRTC_AMNEX_AUTH=<any non-empty JWT; presence is checked, value is not validated>
# UPSTREAM_TIMEOUT_MS=15000
# UPSTREAM_RETRIES=1

# --- web push (VAPID) ---
# Generate a pair with:  node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public key is served to browsers; the private key must never leave the server.
# Leave these unset to disable push entirely — alerts then fall back to in-page only.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# --- road geometry ---
# Routes are fetched once and cached forever, so this is a few hundred requests in the app's
# lifetime. Set ROUTE_GEOMETRY=0 to disable and fall back to straight lines between stops.
# ROUTE_GEOMETRY=1
# OSRM_HOST=https://routing.openstreetmap.de/routed-car
# GEOMETRY_UA=              # identify yourself; the public router asks for a real User-Agent

# --- Play Store wrapper (TWA) ---
# Set after the first bubblewrap build; see twa/README.md. Until TWA_FINGERPRINT is set,
# /.well-known/assetlinks.json returns 404 rather than claiming a link that does not exist.
# TWA_FINGERPRINT=          # SHA256 from: keytool -list -v -keystore android.keystore
# TWA_PACKAGE=in.shivrajsinh.sttracker

# --- data ---
# DB_FILE=.data/st-tracker.db
# IP_HASH_SALT=            # stable salt for report rate-limiting hashes; random per boot if unset

# --- server ---
# PORT=8787
# BIND=0.0.0.0
# RATE_LIMIT_RPM=600     # per IP; high on purpose, see README (carrier NAT)
# TRUST_PROXY=1            # only behind a reverse proxy you control
# ALLOWED_ORIGINS=
# LOG_LEVEL=info

# --- continuous tracking (see README "Continuous tracking" for the load budget) ---
# TRACKER_ENABLED=1
# TRACKER_MAX_PLATES=80
# TRACKER_INTERVAL_MS=25000
# TRACKER_IDLE_INTERVAL_MS=45000
# TRACKER_CONCURRENCY=3
# TRACKER_HISTORY=40
# TRACKER_STATE_FILE=.data/tracker.json

# Owner dashboard at /admin. Unset means the whole surface 404s.
ADMIN_PASSWORD=

# Active upstream health checks for the status page. Probes only methods that real traffic has
# not exercised recently, so they add almost nothing during the day.
PROBE_ENABLED=1
PROBE_INTERVAL_MS=60000
# Probes run every cycle regardless of organic traffic; an uptime figure is only meaningful
# when the sampling rate is constant.

# Observed-timetable harvesting: collects real arrival times from services that have already
# run, on the routes people actually search. Roughly one request per service per day.
HARVEST_ENABLED=1
HARVEST_INTERVAL_MS=120000
HARVEST_ROUTES=10
HARVEST_PER_RUN=15
# Always harvested, whatever the day's popularity: the community's core corridor.
HARVEST_PINNED=470>462,462>470

# Google Geocoding, for bus stand positions the operator's own feed has not reached.
# LEAVE UNSET unless you accept the licensing position documented in CLAUDE.md: Google's terms
# require geocoding results to be shown on a Google map and restrict storing the coordinates,
# and this app does neither. Everything it writes is tagged source='google' so it can be
# removed in one statement.
# GOOGLE_GEOCODING_KEY=
# GEOCODE_DAILY_CAP=300
